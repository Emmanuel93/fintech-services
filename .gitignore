# ── Build outputs ────────────────────────────────────────────────────────────
build/
# Anchored to the repo root: un-anchored `out/` also matched the hexagonal
# `application/port/out/` and `infrastructure/adapter/out/` packages, silently
# excluding the entire outbound layer (repositories, adapters, clients) from git.
/out/
target/

# ── Gradle cache (keep wrapper files) ────────────────────────────────────────
.gradle/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
*.class

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
!.env.example
**/keys/private.pem

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── Evidencia de la regresión E2E ────────────────────────────────────────────
# Cada corrida deja ~150 MB de mp4 del simulador, webm y trace.zip de Playwright:
# 1.4 GB acumulados. Es salida reproducible (`tools/regresion-e2e/run.sh`), no fuente.
tools/regresion-e2e/evidencia/
tools/regresion-e2e/.evidencia/
tools/regresion-e2e/.venv/

# ── Respaldos de base y material desechado ───────────────────────────────────
# Volcados .sql.gz de 23 MB y zips de descarte: no son historia del proyecto.
respaldos/
_to_delete/

# ── Configuración local de Claude Code ───────────────────────────────────────
# Permisos y ajustes de la máquina de cada quien; no es del proyecto.
.claude/

# ── Material: no es código ───────────────────────────────────────────────────────────────────
# Videos, imágenes, audio, documentos exportados y respaldos van en ~/Documents/material-kredius
# (ver README §14). Si uno aparece aquí, es que una herramienta escribió donde no debía.
*.mp4
*.webm
*.mov
*.mkv
*.avi
*.gif
*.png
# The documents' logotype is part of the code: every PDF prints it.
!shared-documents/src/main/resources/branding/*.png
*.jpg
*.jpeg
*.webp
*.heic
*.bmp
*.tiff
*.wav
*.mp3
*.m4a
*.pdf
*.pptx
*.key
*.docx
*.xlsx
*.sql.gz
*.zip
