        <!-- ===================== NOTES ===================== -->
        <mxCell id="noteMigration" value="&lt;b&gt;&#128260; Migracion Gradual&lt;/b&gt;&lt;div style=&quot;margin-top:5.1px&quot;&gt;Feature flags en las apps controlan a que dominio apuntar (legacy o nuevo). El mismo Imperva (WAF SaaS) protege ambos flujos y los mismos backends reciben trafico de ambas rutas durante la transicion.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6.8;fontSize=8.9;fontColor=#5D4037;arcSize=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="972" y="76" width="252" height="110" as="geometry" />
        </mxCell>
        <mxCell id="noteVpcLink" value="&lt;b&gt;&#128274; VPC Link &#8212; Trafico Privado&lt;/b&gt;&lt;div style=&quot;margin-top:5.1px&quot;&gt;Conecta el API Gateway con el ALB privado dentro de la VPC. Trafico HTTPS con verificacion SNI (server_name_to_verify) y validacion de certificado. El ALB privado NO es accesible desde Internet, solo desde el VPC Link.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=6.8;fontSize=8.9;fontColor=#5D4037;arcSize=6;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1170" y="701" width="306" height="187" as="geometry" />
        </mxCell>

        <!-- ===================== LEGEND ===================== -->
        <mxCell id="legendBox" value="&lt;b style=&quot;font-size:11px&quot;&gt;LEYENDA&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;margin-top:6.8px&quot;&gt;&lt;span style=&quot;display:inline-block;width:12.6px;height:11.9px;background:#1E88E5;border-radius:3px;margin-right:6px;vertical-align:middle&quot;&gt;&lt;/span&gt;Componente NUEVO (API Gateway, Lambda Authorizer, VPC Link, ALB Privado)&lt;/div&gt;&lt;div style=&quot;margin-top:5.1px&quot;&gt;&lt;span style=&quot;display:inline-block;width:12.6px;height:11.9px;background:#E53935;border-radius:3px;margin-right:6px;vertical-align:middle&quot;&gt;&lt;/span&gt;Componente LEGACY (Apigee Edge, ALB Publico) &#8212; a deprecar&lt;/div&gt;&lt;div style=&quot;margin-top:5.1px&quot;&gt;&lt;span style=&quot;display:inline-block;width:12.6px;height:11.9px;background:#757575;border-radius:3px;margin-right:6px;vertical-align:middle&quot;&gt;&lt;/span&gt;Componente COMPARTIDO / REUTILIZADO (Imperva WAF, Backend Services en EKS)&lt;/div&gt;&lt;div style=&quot;margin-top:5.1px&quot;&gt;&lt;span style=&quot;display:inline-block;width:12.6px;height:11.9px;background:#8C4FFF;border-radius:3px;margin-right:6px;vertical-align:middle&quot;&gt;&lt;/span&gt;Componente de UNIDAD DE NEGOCIO (Route53 - Hosted Zone propia, no compartida)&lt;/div&gt;&lt;div style=&quot;margin-top:8.5px&quot;&gt;&#8594; Flujo de datos (flecha solida)&lt;/div&gt;&lt;div style=&quot;margin-top:3.4px&quot;&gt;&#8677; Autenticacion / Autorizacion (flecha punteada azul)&lt;/div&gt;&lt;div style=&quot;margin-top:3.4px&quot;&gt;&lt;span style=&quot;color:#E53935&quot;&gt;&#9644;&#9644;&lt;/span&gt; Flujo Legacy &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#1E88E5&quot;&gt;&#9644;&#9644;&lt;/span&gt; Flujo Nuevo&lt;/div&gt;&lt;div style=&quot;margin-top:8.5px&quot;&gt;&lt;b&gt;Agrupaciones AWS:&lt;/b&gt; AWS Cloud &gt; Region &gt; VPC &gt; Availability Zone &gt; Subnet&lt;/div&gt;&lt;div style=&quot;margin-top:3.4px&quot;&gt;Route53 = servicio global AWS (fuera de Region), propiedad de la unidad de negocio. Imperva/Apigee = SaaS externo (fuera de AWS Cloud).&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BDBDBD;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=12.6;spacingTop=10.2;fontSize=9.3;fontColor=#333333;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="54" y="1764" width="504" height="246" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
