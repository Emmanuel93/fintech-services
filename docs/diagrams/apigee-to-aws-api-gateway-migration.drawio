  <diagram id="apigee-aws-migration" name="Apigee to AWS API Gateway Migration">
    <mxGraphModel dx="1780" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1602" pageHeight="2040" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="titleText" value="Migracion de API Gateway: Apigee Edge (Legacy) -&gt; AWS API Gateway HTTP v2 (New)" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="54" y="13" width="1170" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitleText" value="Coexistencia de flujos legacy y nuevo durante la migracion gradual &#8226; Route53 es servicio global AWS (fuera de Region) &#8226; Imperva y Apigee son SaaS externo (fuera de AWS Cloud)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10.2;fontStyle=2;fontColor=#757575;" vertex="1" parent="1">
          <mxGeometry x="54" y="38" width="1170" height="17" as="geometry" />
        </mxCell>

        <!-- ===================== MOBILE / WEB APPS (client, outside everything) ===================== -->
        <mxCell id="mobileApp_card" value="&lt;b&gt;Mobile / Web Apps&lt;/b&gt;&lt;div style=&quot;font-size:8.5px;margin-top:3.4px;text-align:left&quot;&gt;&#8226; Clientes que consumen APIs&lt;br&gt;&#8226; Config. dinamica por feature flags&lt;br&gt;&#8226; Apunta a dominio legacy o nuevo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;arcSize=8;fontColor=#232F3E;verticalAlign=top;align=center;spacingTop=47.6;fontSize=10.2;" vertex="1" parent="1">
