# Copiar como .env y ajustar antes de levantar con Docker.
# cp .env.example .env

# ── API Gateway ───────────────────────────────────────────────────────────────
# Puerto del host para el gateway.
GATEWAY_PORT=8080

# ── identity-service — llaves RSA ────────────────────────────────────────────
# Generar una sola vez:
#   openssl genrsa -out services/identity-service/src/main/resources/keys/private.pem 2048
#   openssl rsa -in services/identity-service/src/main/resources/keys/private.pem \
#               -pubout -out services/gateway-service/keys/public.pem
# private.pem está en .gitignore. public.pem puede commitearse.
AUTH_PRIVATE_KEY_PATH=/etc/identity/keys/private.pem
AUTH_PUBLIC_KEY_PATH=/etc/identity/keys/public.pem

AUTH_ACCESS_TOKEN_EXPIRY_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRY_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=30

# ── channel-mobile-service ────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_CODE_VALIDATION=true
# Solo para ambientes bajos (OTP_CODE_VALIDATION=false):
# OTP_DEV_CODE=123456
KYC_SESSION_EXPIRY_MINUTES=30

# ── origination-service ───────────────────────────────────────────────────────
ORIGINATION_PROSPECT_EXPIRY_DAYS=30

# ── scoring-service ───────────────────────────────────────────────────────────
# REQUERIDO en producción. Default es sandbox para desarrollo local.
# Credencial de Círculo de Crédito (sandbox o productiva). No se versiona; con
# SCORING_CIRCULO_MOCK_ENABLED=true no se usa.
CIRCULO_CREDITO_API_KEY=

# ── disbursement-service ──────────────────────────────────────────────────────
# Apagar el job de despacho deja las órdenes en cola sin perderlas: útil para
# congelar pagos en un incidente sin tumbar el servicio.
DISBURSEMENT_DISPATCH_ENABLED=true

# ── stp-service ───────────────────────────────────────────────────────────────
# stub | real. En producción DEBE ser real: con perfil prod el stub se niega a arrancar.
STP_GATEWAY_MODE=stub
STP_INBOUND_TOPIC=disbursement.stp-requested
STP_POLLING_ENABLED=true

# Verificación del sello que STP devuelve en la conciliación: ENFORCE | WARN | OFF.
# WARN por default porque la cadena exacta que STP firma en esa respuesta todavía no está
# confirmada contra su especificación: bloquear contra una suposición dejaría sin confirmar
# dinero que ya salió del banco. Pasar a ENFORCE en producción una vez cerrado ese punto.
STP_SIGNATURE_POLICY=WARN

# Custodia de llaves (envelope encryption). La KEK cifra las llaves privadas de
# cada empresa; sin ella no se puede firmar nada. NUNCA se commitea y NUNCA vive
# en la base de datos — en producción va en el gestor de secretos.
# Generar 32 bytes en Base64:
#   openssl rand -base64 32
STP_CURRENT_KEK_ID=local
STP_KEK_LOCAL=

# Salt del HMAC con el que se enmascara la cuenta del beneficiario antes de
# persistirla. Distinto por ambiente.
STP_ACCOUNT_HASH_SALT=cambiar-en-cada-ambiente

# Endpoints de STP. Los defaults son los de demo; producción los sobreescribe.
STP_BASE_URL=https://demo.stpmex.com:7024/speiws/rest/
STP_CONSULTA_BASE_URL=https://efws-dev.stpmex.com/efws/API/

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
POSTGRES_USER=fintech
POSTGRES_PASSWORD=fintech

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_PORT=9092

# Límites de tasa del gateway. Por default los de producción
# (rate-limits.conf). En local conviene la variante holgada para que la suite
# E2E de la app no choque con el límite de 3 registros por minuto:
#   GATEWAY_RATE_LIMITS=rate-limits.local.conf
GATEWAY_RATE_LIMITS=rate-limits.conf

# Exportador de trazas. Apagado por default: el collector sólo existe con
# `--profile observability`. Al levantar ese perfil, ponerlo en `otlp`.
OTEL_TRACES_EXPORTER=none

# Ambiente declarado. Los simuladores de proveedor sólo arrancan en local, dev, test, ci, qa o staging.
FINTECH_ENVIRONMENT=local

# ── Corte y estados de cuenta ─────────────────────────────────────────────────
# Particiones de closing.cutoff-due y closing.cutoff-closed: el techo de pods trabajando a la vez.
CLOSING_CUTOFF_PARTITIONS=12
# Hilos por pod que cortan cuentas / que generan PDF. Paralelismo = min(particiones, réplicas × hilos).
CLOSING_CUTOFF_CONCURRENCY=4
STATEMENT_PARTITIONS=12
STATEMENT_CONCURRENCY=4

# Crones de negocio en pausa: el E2E y la demo disparan cada job en su momento simulado (nunca en producción).
BUSINESS_CRONS_PAUSED=false

# Which amounts the STP stub reads a scenario from: ARMED (only the ones a run arms; the local stack) or ANY
# (every amount's cents, as the connector's tests do).
STP_STUB_SCENARIO_AMOUNTS=ARMED
